generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  balance      Float      @default(1000)
  createdAt    DateTime   @default(now())
  orders       Order[]
  positions    Position[]
}

model Order {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  symbol     String
  marketName String
  side       String
  quantity   Int
  fillPrice  Float
  totalCost  Float
  createdAt  DateTime @default(now())
}

model Position {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  symbol     String
  marketName String
  side       String
  quantity   Int
  avgPrice   Float
  updatedAt  DateTime @updatedAt

  @@unique([userId, symbol, side])
}